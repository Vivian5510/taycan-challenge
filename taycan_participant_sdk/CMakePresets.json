{
  "version": 5,
  "configurePresets": [
    {
      "name": "native-arm64-dev",
      "displayName": "Native macOS ARM64 development (not Linux acceptance)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/../build/f2-native-baseline-arm64-20261030",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "TAYCAN_BUILD_PERF_BENCHMARKS": "ON",
        "CONTEST_ENGINE_DIR": "${sourceDir}/../experiments/faster-native-adapter",
        "TAYCAN_F2_LOG_PAGE_BITS": "20",
        "TAYCAN_F2_OVERFLOW_PAGE_BITS": "12",
        "TAYCAN_F2_FIX_RECOVERY_VERSION": "ON",
        "TAYCAN_F2_FIX_RECOVERY_FRONTIER": "ON"
      }
    },
    {
      "name": "f2-durable-arm64-dev",
      "displayName": "F2 durable single-request with disk index migration and compaction (macOS development)",
      "inherits": "native-arm64-dev",
      "binaryDir": "${sourceDir}/../build/f2-durable-arm64-dev",
      "cacheVariables": {
        "TAYCAN_F2_SYNC_STRATEGY": "data-log",
        "TAYCAN_F2_PREFIX_BLOCK_BYTES": "512",
        "TAYCAN_F2_NATIVE_IO": "posix-aio",
        "TAYCAN_F2_MAC_SYNC": "fsync",
        "TAYCAN_F2_DURABLE_COMPACTION": "ON",
        "TAYCAN_F2_DATA_SEGMENT_BITS": "23"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-arm64-dev",
      "configurePreset": "native-arm64-dev",
      "jobs": 4
    },
    {
      "name": "f2-durable-arm64-dev",
      "configurePreset": "f2-durable-arm64-dev",
      "jobs": 4
    }
  ]
}
